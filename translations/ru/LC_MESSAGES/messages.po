msgid "Access Before Assign"
msgstr "Переменная `{name}` используется в строке {access_line_number} до того, как ей присвоено значение. Попробуй задать переменную перед её использованием."

msgid "Cyclic Var Definition"
msgstr "Переменная `{variable}` используется справа от команды `{is}` до того, как ей присвоено значение. Попробуй задать переменную перед её использованием."

msgid "Else Without If Error"
msgstr "В строке {line_number} команда `{else}` используется перед `{if}`. Попробуй написать `{if}` перед `{else}`."

msgid "Function Undefined"
msgstr "Функция {name} используется без определения. Попробуй определить её перед использованием."

msgid "Has Blanks"
msgstr "Похоже, твоя программа ещё не готова. Заполни пропуски кодом."

msgid "Incomplete"
msgstr "В строке {line_number} не хватает части кода в `{incomplete_command}`. Попробуй добавить недостающее."

msgid "Incomplete Repeat"
msgstr "В строке {line_number} после `{repeat}` не хватает команды `{command}`. Попробуй добавить её."

msgid "Invalid"
msgstr "`{invalid_command}` — это не команда Hedy уровня {level}. Попробуй использовать `{guessed_command}`."

msgid "Invalid Argument"
msgstr "Команду `{command}` нельзя использовать с `{invalid_argument}`. Попробуй заменить `{invalid_argument}` на {allowed_types}."

msgid "Invalid Argument Type"
msgstr "Команда `{command}` не работает с `{invalid_argument}`, потому что это {invalid_type}. Попробуй заменить `{invalid_argument}` на {allowed_types}."

msgid "Invalid At Command"
msgstr "Команду `{command}` нельзя использовать начиная с уровня 16. Попробуй использовать квадратные скобки `[]` для списков."

msgid "Invalid Space"
msgstr "Строка {line_number} начинается с пробела. Попробуй удалить его."

msgid "Invalid Type Combination"
msgstr "`{invalid_argument}` и `{invalid_argument_2}` нельзя использовать с командой `{command}`, потому что одно значение имеет тип {invalid_type}, а другое — {invalid_type_2}. Попробуй заменить `{invalid_argument}` на {invalid_type_2} или `{invalid_argument_2}` на {invalid_type}."

msgid "Lonely Echo"
msgstr "Команда `{echo}` используется перед `{ask}` или без неё. Попробуй написать `{ask}` перед `{echo}`."

msgid "Lonely Text"
msgstr "Похоже, в строке {line_number} перед текстом не хватает команды. Попробуй добавить к тексту нужную команду."

msgid "Missing Additional Command"
msgstr "В строке {line_number} у команды `{command}` чего-то не хватает. Попробуй использовать `{missing_command}` в своём коде."

msgid "Missing Colon Error"
msgstr "Команде `{command}` нужно двоеточие `:` в конце строки {line_number}. Начиная с уровня 17 добавляй `:` в конце строк с командами."

msgid "Missing Command"
msgstr "Похоже, в строке {line_number} не хватает команды. Загляни в раздел с упражнением, чтобы узнать, какую команду использовать."

msgid "Missing Inner Command"
msgstr "Похоже, в строке {line_number} не хватает команды внутри `{command}`. Загляни в раздел с упражнением, чтобы узнать, какую команду использовать."

msgid "Missing Square Brackets"
msgstr "У списка, созданного в строке {line_number}, нет квадратных скобок `[]`. Попробуй заключить список в квадратные скобки `[]`."

msgid "Missing Variable"
msgstr "У команды `{command}` не хватает переменной в начале строки. Попробуй написать переменную перед `{command}`."

msgid "Misspelled At Command"
msgstr "Похоже, в `{invalid_argument}` в строке {line_number} есть опечатка. Попробуй написать `{command}` вместо этого."

msgid "No Indentation"
msgstr "В строке {line_number} слишком мало пробелов: {leading_spaces}. Попробуй увеличивать отступ на {indent_size} пробелов для каждого нового блока."

msgid "Non Decimal Variable"
msgstr "В строке {line_number} используется число, которое Hedy не поддерживает! Попробуй записать число в десятичной системе, например 2."

msgid "Output"
msgstr "Вывод"

msgid "Parse"
msgstr "В строке {location[0]} используется недопустимый символ `{character_found}`. Проверь, нет ли в коде пропущенного или лишнего символа."

msgid "Pressit Missing Else"
msgstr "В коде не хватает `{else}` для обработки нажатий других клавиш. Попробуй добавить `{else}`."

msgid "Runtime Index Error"
msgstr "Список {name} пуст или не указан индекс его элемента. Убедись, что список не пуст, или попробуй написать число внутри `[]`, чтобы указать индекс."

msgid "Runtime Value Error"
msgstr "Команда `{command}` получила недопустимое значение `{value}`. {tip}."

msgid "Runtime Values Error"
msgstr "Команда `{command}` получила недопустимые значения `{value}` и `{value}`. {tip}."

msgid "Save Microbit code "
msgstr "Сохранить код Microbit"

msgid "Too Big"
msgstr "В программе {lines_of_code} строк, но мы можем обработать только {max_lines}. Попробуй сократить свою программу."

msgid "Too Few Indents"
msgstr "В строке {line_number} слишком мало пробелов ({leading_spaces}). Попробуй добавить ещё один пробел."

msgid "Too Many Indents"
msgstr "В строке {line_number} слишком много пробелов ({leading_spaces}). Попробуй удалить лишний пробел."

msgid "Unexpected Indentation"
msgstr "В строке {line_number} слишком много пробелов ({leading_spaces}). Попробуй увеличивать отступ на {indent_size} пробелов для каждого нового блока."

msgid "Unquoted Assignment"
msgstr "Текст справа от `{is}` не заключён в кавычки. На этом уровне текст нужно писать в кавычках. Попробуй добавить их для текста {text}"

msgid "Unquoted Equality Check"
msgstr "Код проверяет, равна ли переменная нескольким словам. Попробуй заключить эти слова в кавычки."

msgid "Unquoted Text"
msgstr "Похоже, у текста для `{ask}` или `{print}` не хватает кавычек. Попробуй добавить кавычки для {unquotedtext}."

msgid "Unsupported Float"
msgstr "В коде используются нецелые числа, которые пока не поддерживаются. Попробуй заменить `{value}` на целое число."

msgid "Unsupported String Value"
msgstr "Текст не может содержать значение `{invalid_value}`. Попробуй удалить это значение или изменить его тип."

msgid "Unused Variable"
msgstr "Переменная {variable_name} определена в строке {line_number}, но не используется. Попробуй использовать её или удалить."

msgid "Var Undefined"
msgstr "Переменная `{name}` используется до того, как ей присвоено значение. Попробуй задать переменную перед использованием или заключить `{name}` в кавычки."

msgid "Wrong Level"
msgstr "Это правильный код Hedy, но `{offending_keyword}` используется на уровне {working_level}. {tip}"

msgid "Wrong Number of Arguments"
msgstr "У функции {name} неверное количество аргументов: {used_number}. Попробуй указать {defined_number}."

