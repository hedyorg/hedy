msgid "Access Before Assign"
msgstr "Мы обнаружили, что переменная `{name}` используется в строке {access_line_number} до её установки. Можно ли установить переменную перед её использованием?"

msgid "Cyclic Var Definition"
msgstr "Имя `{variable}` должно быть присвоено значение до того как вы используете его справа после команды `{is}`. Можете ли вы установить переменную перед ее использованием?"

msgid "Else Without If Error"
msgstr "Мы обнаружили, что существует `{else}` используется перед `{if}` на линии {line_number} . Можете ли вы попробовать написать `{if}`перед `{else}`?"

msgid "Function Undefined"
msgstr "Мы обнаружили, что функция {name} используется без определения. Можете ли вы определить функцию до ее использования?"

msgid "Has Blanks"
msgstr "Похоже, код неполный. Можете заполнить пропуски кодом?"

msgid "Incomplete"
msgstr "Мы обнаружили, что часть кода отсутствует в ` {incomplete_command} ` на линии {line_number} . Можете ли вы попробовать добавить то, чего не хватает?"

msgid "Incomplete Repeat"
msgstr "Похоже, в команде `{repeat}` на строке {line_number} не хватает команды `{command}`. Попробуйте добавить её."

msgid "Invalid"
msgstr "`{invalid_command}` — это не команда Hedy уровня {level}. Может, вы имели в виду `{guessed_command}`?"

msgid "Invalid Argument"
msgstr "Команду `{command}` нельзя использовать с `{invalid_argument}`. Попробуйте заменить `{invalid_argument}` на {allowed_types}."

msgid "Invalid Argument Type"
msgstr "Команда `{command}` не работает с `{invalid_argument}`, потому что это {invalid_type}. Попробуйте заменить `{invalid_argument}` на {allowed_types}."

msgid "Invalid At Command"
msgstr "Команду `{command}` нельзя использовать начиная с уровня 16. Попробуйте использовать квадратные скобки `[]` для списков."

msgid "Invalid Space"
msgstr "Похоже, строка {line_number} начинается с пробела. Попробуйте удалить этот пробел."

msgid "Invalid Type Combination"
msgstr "`{invalid_argument}` и `{invalid_argument_2}` нельзя использовать с командой `{command}`, потому что первое — {invalid_type}, а второе — {invalid_type_2}. Попробуйте заменить `{invalid_argument}` на {invalid_type_2} или `{invalid_argument_2}` на {invalid_type}."

msgid "Lonely Echo"
msgstr "Команда `{echo}` используется до команды `{ask}` или без неё. Попробуйте написать `{ask}` перед `{echo}`."

msgid "Lonely Text"
msgstr "Похоже, в коде не хватает команды с текстом, использованным в строке {line_number}. Попробуйте написать нужную команду вместе с текстом."

msgid "Missing Additional Command"
msgstr "Мы обнаружили, что команда ` {command} ` на линии {line_number} чего-то не хватает. Можете ли вы попробовать использовать ` {missing_command} ` в вашем коде?"

msgid "Missing Colon Error"
msgstr "Мы обнаружили, что `{command}`нужен `:` в конце строки {line_number} . Начиная с уровень 17, можете ли вы начать добавлять `:` в конце строки с командами?"

msgid "Missing Command"
msgstr "Похоже, в строке {line_number} не хватает команды. Посмотрите раздел с упражнением, чтобы узнать, какую команду использовать."

msgid "Missing Inner Command"
msgstr "Похоже, для выражения `{command}` в строке {line_number} не хватает команды. Посмотрите раздел с упражнением, чтобы узнать, какую команду использовать."

msgid "Missing Square Brackets"
msgstr "Мы обнаружили, что список, созданный вами онлайн, {line_number} отсутствуют квадратные скобки `[]`. Можете ли вы попробовать добавить квадратные скобки вокруг списка `[]`?"

msgid "Missing Variable"
msgstr "Мы обнаружили, что `{command}` отсутствует переменная в начале строки. Можете ли вы попробовать записать переменную перед `{command}?`"

msgid "Misspelled At Command"
msgstr "Похоже, в `{invalid_argument}` на строке {line_number} опечатка. Попробуйте написать `{command}` вместо него."

msgid "No Indentation"
msgstr "Похоже, в строке {line_number} использовано слишком мало пробелов ({leading_spaces}). Попробуйте увеличивать отступ на {indent_size} для каждого нового блока."

msgid "Non Decimal Variable"
msgstr "Похоже, в строке {line_number} вы использовали число, которое Hedy не поддерживает! Попробуйте десятичное число, например 2?"

msgid "Output"
msgstr "Вывод"

msgid "Parse"
msgstr "В строке {location[0]} используется `{character_found}`, что недопустимо. Поищите в коде пропущенный или лишний символ."

msgid "Pressit Missing Else"
msgstr "Похоже, в коде не хватает `{else}` для обработки других нажатий клавиш. Попробуйте добавить `{else}` в код."

msgid "Runtime Index Error"
msgstr "Похоже, список {name} пуст или в нём отсутствует индекс. Убедитесь, что список не пуст, или попробуйте вписать число в `[]` вместо пропущенного индекса."

msgid "Runtime Value Error"
msgstr "Похоже, `{command}` получила недопустимое значение `{value}`. {tip}."

msgid "Runtime Values Error"
msgstr "Похоже, `{command}` получила недопустимые значения `{value}` и `{value}`. {tip}."

msgid "Save Microbit code "
msgstr "Сохранить код Microbit"

msgid "Too Big"
msgstr "В программе {lines_of_code} строк, но мы можем обработать только {max_lines} строк. Попробуйте сократить программу."

msgid "Too Few Indents"
msgstr "Похоже, в строке {line_number} слишком мало пробелов ({leading_spaces}). Попробуйте добавить ещё один пробел."

msgid "Too Many Indents"
msgstr "Похоже, в строке {line_number} слишком много пробелов ({leading_spaces}). Попробуйте убрать лишний пробел."

msgid "Unexpected Indentation"
msgstr "В строке {line_number} слишком много пробелов ({leading_spaces}). Попробуйте добавлять по {indent_size} пробелов для каждого нового блока."

msgid "Unquoted Assignment"
msgstr "Текст справа от `{is}` не заключён в кавычки. На этом уровне текст нужно писать в кавычках. Попробуйте сделать это для текста {text}"

msgid "Unquoted Equality Check"
msgstr "Код пытается проверить, равна ли переменная нескольким словам. Попробуйте заключить слова, которые хотите проверить, в кавычки."

msgid "Unquoted Text"
msgstr "Похоже, текст для `{ask}` или `{print}` не заключён в кавычки. Попробуйте добавить кавычки для {unquotedtext}."

msgid "Unsupported Float"
msgstr "Код использует нецелые числа, которые пока не поддерживаются. Попробуйте заменить `{value}` на целое число."

msgid "Unsupported String Value"
msgstr "Текст содержит значение `{invalid_value}`, которое в нём недопустимо. Попробуйте убрать это значение или изменить его тип."

msgid "Unused Variable"
msgstr "Переменная {variable_name} определена в строке {line_number}, но не используется. Попробуйте использовать её или удалить."

msgid "Var Undefined"
msgstr "Переменная `{name}` используется до того, как ей присвоено значение. Присвойте значение переменной до её использования или заключите `{name}` в кавычки."

msgid "Wrong Level"
msgstr "Написанный код — правильный код Hedy, но `{offending_keyword}` используется на уровне {working_level}. {tip}"

msgid "Wrong Number of Arguments"
msgstr "Функция {name} получила неверное число аргументов: {used_number}. Попробуйте указать {defined_number}."

