msgid "Access Before Assign"
msgstr "Abbiamo notato che la variabile {name} è in uso alla riga {access_line_number}, senza avere prima impostato il suo valore. Potresti dare un valore alla variabile prima che venga utilizzata?"

msgid "Cyclic Var Definition"
msgstr "Abbiamo rilevato che la variabile `{variable}` viene usata sul lato destro del comando `{is}` prima di essere impostata. Puoi impostare la variabile prima di usarla?"

msgid "Else Without If Error"
msgstr "Abbiamo rilevato che c'è un '{else}' usato prima di un '{if}' nella linea {line_number}. Puoi provare a scrivere un '{if}' prima di '{else}'?"

msgid "Function Undefined"
msgstr "Abbiamo rilevato che una funzione {name} è stata usata senza essere definita. Puoi definire la funzione prima di usarla?"

msgid "Has Blanks"
msgstr "Abbiamo rilevato che il codice sembra incompleto. Puoi riempire gli spazi vuoti con del codice?"

msgid "Incomplete"
msgstr "Abbiamo rilevato che una parte del codice manca in '{incomplete_command}' nella linea {line_number}. Puoi provare ad aggiungere quello che manca?"

msgid "Incomplete Repeat"
msgstr "Abbiamo rilevato che al `{repeat}` alla riga {line_number} manca un comando `{command}`. Puoi provare ad aggiungerlo?"

msgid "Invalid"
msgstr "Abbiamo rilevato che `{invalid_command}` non è un comando di Hedy del livello {level}. Puoi provare a usare `{guessed_command}`?"

msgid "Invalid Argument"
msgstr "Abbiamo rilevato che '{command}' non è utilizzabile con '{invalid_argument}'. Puoi provare a cambiare '{invalid_argument}' in {allowed_types}?"

msgid "Invalid Argument Type"
msgstr "Abbiamo rilevato che '{command}' non funziona con '{invalid_argument}' perché è {invalid_type}. Prova a cambiare '{invalid_argument}' in {allowed_types}."

msgid "Invalid At Command"
msgstr "Abbiamo rilevato che '{command}' potrebbe non essere usato dal livello 16 in avanti. Prova ad usare le parentesi quadre '[]' per questa lista."

msgid "Invalid Space"
msgstr "Abbiamo rilevato che la riga {line_number} inizia con uno spazio. Puoi provare a togliere lo spazio?"

msgid "Invalid Type Combination"
msgstr "Abbiamo rilevato che `{invalid_argument}` e `{invalid_argument_2}` non possono essere usati con `{command}` perché uno è {invalid_type} e l'altro è {invalid_type_2}. Puoi provare a cambiare `{invalid_argument}` in {invalid_type_2} oppure `{invalid_argument_2}` in {invalid_type}?"

#, fuzzy
msgid "Lonely Echo"
msgstr "Abbiamo rilevato che un `{echo}` viene usato prima di un `{ask}` o senza un `{ask}`. Puoi provare a scrivere un `{ask}` prima dell'`{echo}`?"

msgid "Lonely Text"
msgstr "Abbiamo rilevato che nel codice sembra mancare un comando insieme al testo usato alla riga {line_number}. Puoi provare a scrivere il comando necessario insieme al testo"

msgid "Missing Additional Command"
msgstr "Abbiamo rilevato che al comando `{command}` alla riga {line_number} manca qualcosa. Puoi provare a usare `{missing_command}` nel tuo codice?"

msgid "Missing Colon Error"
msgstr "Abbiamo rilevato che `{command}` ha bisogno di un `:` alla fine della riga {line_number}. A partire dal livello 17, puoi iniziare ad aggiungere un `:` alla fine delle righe con i comandi?"

msgid "Missing Command"
msgstr "Abbiamo rilevato che alla riga {line_number} sembra mancare un comando. Puoi provare a guardare la sezione dell'esercizio per capire quale comando usare?"

msgid "Missing Inner Command"
msgstr "Abbiamo rilevato che sembra mancare un comando per l'istruzione `{command}` alla riga {line_number}. Puoi provare a guardare la sezione dell'esercizio per capire quale comando usare?"

msgid "Missing Square Brackets"
msgstr "Abbiamo rilevato che alla lista che hai creato alla riga {line_number} mancano le parentesi quadre `[]`. Puoi provare ad aggiungere le parentesi quadre `[]` attorno alla lista?"

msgid "Missing Variable"
msgstr "Abbiamo rilevato che a `{command}` manca una variabile all'inizio della riga. Puoi provare a scrivere la variabile prima di `{command}?`"

msgid "Misspelled At Command"
msgstr "Abbiamo rilevato che `{invalid_argument}` sembra contenere un errore di battitura alla riga {line_number}. Puoi provare a scrivere `{command}` al suo posto?"

msgid "No Indentation"
msgstr "Abbiamo rilevato che alla riga {line_number} sembrano esserci troppo pochi spazi ({leading_spaces}). Puoi provare ad aumentare l'indentazione di {indent_size} per ogni nuovo blocco?"

msgid "Non Decimal Variable"
msgstr "Abbiamo rilevato che alla riga {line_number} hai usato un numero che Hedy non supporta! Puoi provare con un numero decimale, come 2?"

msgid "Output"
msgstr "Output"

msgid "Parse"
msgstr "Abbiamo rilevato che alla riga {location[0]} viene usato `{character_found}`, che non è consentito. Puoi provare a cercare un carattere mancante o in più nel tuo codice?"

msgid "Pressit Missing Else"
msgstr "Abbiamo rilevato che nel codice manca un `{else}` per gestire la pressione degli altri tasti. Puoi provare ad aggiungere un `{else}` al tuo codice?"

msgid "Runtime Index Error"
msgstr "Abbiamo rilevato che la lista {name} è vuota oppure manca il suo indice. Puoi controllare che la lista non sia vuota, oppure provare a scrivere un numero dentro le `[]` per l'indice mancante?"

msgid "Runtime Value Error"
msgstr "Abbiamo rilevato che `{command}` ha ricevuto il valore non consentito `{value}`. {tip}."

msgid "Runtime Values Error"
msgstr "Abbiamo rilevato che `{command}` ha ricevuto i valori non consentiti `{value}` e `{value}`. {tip}."

msgid "Save Microbit code "
msgstr "Salva il codice per Micro:bit"

msgid "Too Big"
msgstr "Abbiamo rilevato che il programma ha {lines_of_code} righe, ma possiamo elaborarne solo {max_lines}. Puoi provare ad accorciare il tuo programma?"

msgid "Too Few Indents"
msgstr "Abbiamo rilevato che la riga {line_number} ha troppo pochi spazi ({leading_spaces}). Puoi provare ad aggiungere uno spazio?"

msgid "Too Many Indents"
msgstr "Abbiamo rilevato che la riga {line_number} ha troppi spazi ({leading_spaces}). Puoi provare a togliere lo spazio in più?"

msgid "Unexpected Indentation"
msgstr "Abbiamo rilevato che la riga {line_number} ha troppi spazi ({leading_spaces}). Puoi provare ad aggiungere {indent_size} spazi in più per ogni nuovo blocco?"

msgid "Unquoted Assignment"
msgstr "Abbiamo rilevato che il testo a destra di `{is}` non è scritto tra virgolette. In questo livello devi iniziare a scrivere il testo tra virgolette. Prova a farlo per il testo {text}"

msgid "Unquoted Equality Check"
msgstr "Abbiamo rilevato che il codice cerca di controllare se una variabile è uguale a più parole. Puoi provare a mettere tra virgolette le parole che vuoi controllare?"

msgid "Unquoted Text"
msgstr "Abbiamo rilevato che al testo di `{ask}` o `{print}` sembrano mancare le virgolette. Puoi provare ad aggiungere le virgolette a {unquotedtext}?"

msgid "Unsupported Float"
msgstr "Abbiamo rilevato che il codice usa numeri non interi, che non sono ancora supportati. Puoi provare a cambiare `{value}` in un numero intero?"

msgid "Unsupported String Value"
msgstr "Abbiamo rilevato che il testo contiene valori che non può contenere: `{invalid_value}`. Puoi provare a togliere il valore scritto o a cambiarne il tipo?"

msgid "Unused Variable"
msgstr "Abbiamo rilevato che la variabile {variable_name} è stata definita alla riga {line_number}, ma non viene usata. Puoi provare a usare la variabile definita oppure a toglierla?"

msgid "Var Undefined"
msgstr "Abbiamo rilevato che la variabile `{name}` viene usata prima di essere impostata. Puoi impostare la variabile prima di usarla, oppure mettere `{name}` tra virgolette?"

msgid "Wrong Level"
msgstr "Abbiamo rilevato che il codice scritto è codice Hedy corretto, ma `{offending_keyword}` è usato al livello {working_level}. {tip}"

msgid "Wrong Number of Arguments"
msgstr "Abbiamo rilevato che la funzione {name} ha un numero sbagliato di argomenti, cioè {used_number}. Puoi provare a scriverne {defined_number}?"

