msgid "Access Before Assign"
msgstr "我們發現變數 `{name}` 在第 {access_line_number} 行使用時還沒設定。請先設定這個變數，再使用它。"

msgid "Cyclic Var Definition"
msgstr "我們發現變數 `{variable}` 還沒設定，就先用在 `{is}` 指令右側了。請先設定這個變數，再使用它。"

msgid "Else Without If Error"
msgstr "我們發現在第 {line_number} 行，`{else}` 寫在 `{if}` 前面。請試著先寫 `{if}`，再寫 `{else}`。"

msgid "Function Undefined"
msgstr "我們發現函式 {name} 還沒定義就被使用了。請先定義這個函式，再使用它。"

msgid "Has Blanks"
msgstr "我們發現程式碼好像還沒完成。你可以在空白處補上程式碼嗎？"

msgid "Incomplete"
msgstr "我們發現第 {line_number} 行的 `{incomplete_command}` 好像少了一部分程式碼。請試著把缺少的內容補上。"

msgid "Incomplete Repeat"
msgstr "我們發現第 {line_number} 行的 `{repeat}` 少了 `{command}` 指令。請試著加上這個指令。"

msgid "Invalid"
msgstr "我們發現 `{invalid_command}` 不是 Hedy 第 {level} 級的指令。請試著改用 `{guessed_command}`。"

msgid "Invalid Argument"
msgstr "`{command}` 不能搭配 `{invalid_argument}` 使用。請試著把 `{invalid_argument}` 改成 {allowed_types}。"

msgid "Invalid Argument Type"
msgstr "`{command}` 無法搭配 `{invalid_argument}` 使用，因為它是 {invalid_type}。請試著把 `{invalid_argument}` 改為 {allowed_types}。"

msgid "Invalid At Command"
msgstr "我們發現從第 16 級開始不能使用 `{command}`。請試著用方括號 `[]` 來表示清單。"

msgid "Invalid Space"
msgstr "我們發現第 {line_number} 行開頭有一個空格。請試著移除這個空格。"

msgid "Invalid Type Combination"
msgstr "我們發現 `{invalid_argument}` 和 `{invalid_argument_2}` 不能搭配 `{command}` 使用，因為一個是 {invalid_type}，另一個是 {invalid_type_2}。請試著將 `{invalid_argument}` 改成 {invalid_type_2}，或將 `{invalid_argument_2}` 改成 {invalid_type}。"

#, fuzzy
msgid "Lonely Echo"
msgstr "我們發現 `{echo}` 用在 `{ask}`之前，或沒有搭配 `{ask}`使用。請試著先寫一個 `{ask}`，再使用 `{echo}`。"

msgid "Lonely Text"
msgstr "我們發現第 {line_number} 行使用的文字似乎少了一個指令。請試著在這段文字前加上需要的指令。"

msgid "Missing Additional Command"
msgstr "我們發現第 {line_number} 行的 `{command}` 指令少了某個部分。請試著在程式碼中使用 `{missing_command}`。"

msgid "Missing Colon Error"
msgstr "我們發現第 {line_number} 行的 `{command}` 結尾需要加上 `:`。從第 17 級開始，請試著在指令那一行的結尾加上 `:`。"

msgid "Missing Command"
msgstr "我們發現第 {line_number} 行似乎少了一個指令。請查看練習區，找找看應該使用哪個指令。"

msgid "Missing Inner Command"
msgstr "我們發現第 {line_number} 行的 `{command}` 陳述式似乎少了一個指令。請查看練習區，找找看應該使用哪個指令。"

msgid "Missing Square Brackets"
msgstr "我們發現第 {line_number} 行建立的清單少了方括號 `[]`。請試著在清單前後加上方括號。"

msgid "Missing Variable"
msgstr "我們發現這一行開頭少了 `{command}` 指令所需的變數。請試著把變數寫在 `{command}` 前面。"

msgid "Misspelled At Command"
msgstr "我們發現第 {line_number} 行的 `{invalid_argument}` 好像拼錯了。請改成 `{command}`。"

msgid "No Indentation"
msgstr "我們發現第 {line_number} 行使用的 {leading_spaces} 個空格似乎不夠。每進入一個新的程式區塊，請將縮排增加 {indent_size} 個空格。"

msgid "Non Decimal Variable"
msgstr "我們發現第 {line_number} 行使用了 Hedy 不支援的數字！請試著使用十進位數字，例如 2。"

msgid "Parse"
msgstr "我們發現第 {location[0]} 行使用了不允許的 `{character_found}`。請檢查程式碼中是否少了或多了某個字元。"

msgid "Pressit Missing Else"
msgstr "我們發現程式碼少了 `{else}`，無法處理其他按鍵。請試著在程式碼中加入 `{else}`。"

msgid "Runtime Index Error"
msgstr "我們發現清單 {name} 是空的，或少了索引。請確認清單不是空的，或試著在 `[]` 中為缺少的索引填入數字。"

msgid "Runtime Value Error"
msgstr "我們發現 `{command}` 收到了不允許使用的值 `{value}`。{tip}"

msgid "Runtime Values Error"
msgstr "我們發現 `{command}` 收到了不允許使用的值 `{value}` 和 `{value}`。{tip}"

msgid "Save Microbit code "
msgstr "儲存 micro:bit 程式碼"

msgid "Too Big"
msgstr "我們發現這個程式有 {lines_of_code} 行，但我們最多只能處理 {max_lines} 行。請試著縮短程式。"

msgid "Too Few Indents"
msgstr "我們發現第 {line_number} 行的空格太少（目前有 {leading_spaces} 個）。請試著再加一個空格。"

msgid "Too Many Indents"
msgstr "我們發現第 {line_number} 行有太多空格 ({leading_spaces} 個)。請試著移除多餘的空格。"

msgid "Unexpected Indentation"
msgstr "我們發現第 {line_number} 行的空格太多（目前有 {leading_spaces} 個）。每進入一個新的程式區塊，請以 {indent_size} 個空格為單位調整縮排。"

msgid "Unquoted Assignment"
msgstr "我們發現 `{is}` 右側的文字沒有放在引號中。從這個等級開始，文字必須寫在引號中。請試著將文字 {text} 放入引號。"

msgid "Unquoted Equality Check"
msgstr "我們發現程式碼正在檢查變數是否等於一段包含多個單字的文字。請試著將要檢查的文字放在引號中。"

msgid "Unquoted Text"
msgstr "我們發現 `{ask}` 或 `{print}` 使用的文字似乎少了引號。請試著在 {unquotedtext} 前後加上引號。"

msgid "Unsupported Float"
msgstr "我們發現程式碼使用了目前尚未支援的非整數。請試著將 `{value}` 改成整數。"

msgid "Unsupported String Value"
msgstr "我們發現文字中包含不能使用的值 `{invalid_value}`。請試著移除這個值，或變更它的類型。"

msgid "Unused Variable"
msgstr "我們發現第 {line_number} 行定義了變數 {variable_name}，但尚未使用。請試著使用這個變數，或將它移除。"

msgid "Var Undefined"
msgstr "我們發現變數 `{name}` 還沒設定就被使用了。請先設定變數再使用，或將 `{name}` 放在引號中。"

msgid "Wrong Level"
msgstr "我們發現這段程式碼是正確的 Hedy 程式碼，但 `{offending_keyword}` 是第 {working_level} 級使用的指令。{tip}"

msgid "Wrong Number of Arguments"
msgstr "我們發現函式 {name} 使用了錯誤的引數數量：{used_number} 個。請試著改成 {defined_number} 個。"

