msgid "Access Before Assign"
msgstr "Zistili sme, že premenná `{name}` sa na riadku {access_line_number} používa skôr, ako je nastavená. Vieš ju nastaviť ešte pred použitím?"

msgid "Cyclic Var Definition"
msgstr "Zistili sme, že premenná `{variable}` sa na pravej strane príkazu `{is}` používa skôr, ako je nastavená. Vieš ju nastaviť ešte pred použitím?"

msgid "Else Without If Error"
msgstr "Zistili sme, že `{else}` sa na riadku {line_number} používa pred príkazom `{if}`. Skúsiš napísať `{if}` pred `{else}`?"

msgid "Function Undefined"
msgstr "Zistili sme, že funkcia {name} sa používa bez toho, aby bola definovaná. Vieš funkciu definovať ešte pred použitím?"

msgid "Has Blanks"
msgstr "Zistili sme, že kód vyzerá ako nedokončený. Vieš prázdne miesta doplniť kódom?"

msgid "Incomplete"
msgstr "Zistili sme, že pri príkaze `{incomplete_command}` na riadku {line_number} niečo chýba. Skúsiš doplniť, čo chýba?"

msgid "Incomplete Repeat"
msgstr "Zistili sme, že pri `{repeat}` na riadku {line_number} chýba príkaz `{command}`. Skúsiš ho doplniť?"

msgid "Invalid"
msgstr "Zistili sme, že `{invalid_command}` nie je príkaz úrovne Hedy {level}. Skúsiš použiť `{guessed_command}`?"

msgid "Invalid Argument"
msgstr "Zistili sme, že `{command}` sa nedá použiť s `{invalid_argument}`. Skúsiš zmeniť `{invalid_argument}` na {allowed_types}?"

msgid "Invalid Argument Type"
msgstr "Zistili sme, že `{command}` nefunguje s `{invalid_argument}`, pretože je to {invalid_type}. Skúsiš zmeniť `{invalid_argument}` na {allowed_types}?"

msgid "Invalid At Command"
msgstr "Zistili sme, že `{command}` sa od úrovne 16 už nedá použiť. Skúsiš pri zoznamoch použiť hranaté zátvorky `[]`?"

msgid "Invalid Space"
msgstr "Zistili sme, že riadok {line_number} začína medzerou. Skúsiš medzeru odstrániť?"

msgid "Invalid Type Combination"
msgstr "Zistili sme, že `{invalid_argument}` a `{invalid_argument_2}` sa nedajú použiť s `{command}`, pretože jedno je {invalid_type} a druhé je {invalid_type_2}. Skúsiš zmeniť `{invalid_argument}` na {invalid_type_2} alebo `{invalid_argument_2}` na {invalid_type}?"

msgid "Lonely Echo"
msgstr "Zistili sme, že `{echo}` sa používa pred `{ask}` alebo bez neho. Skúsiš napísať `{ask}` pred `{echo}`?"

msgid "Lonely Text"
msgstr "Zistili sme, že v kóde chýba príkaz s textom, ktorý bol použitý v riadku {line_number}. Skús napísať potrebný príkaz s textom"

msgid "Missing Additional Command"
msgstr "Zistili sme, že príkazu `{command}` na riadku {line_number} niečo chýba. Skúsiš v kóde použiť `{missing_command}`?"

msgid "Missing Colon Error"
msgstr "Zistili sme, že `{command}` potrebuje na konci riadka {line_number} dvojbodku `:`. Od úrovne 17 skúsiš na koniec riadka s príkazmi dopĺňať `:`?"

msgid "Missing Command"
msgstr "Zistili sme, že na riadku {line_number} zrejme chýba príkaz. Pozrieš sa do cvičenia, ktorý príkaz použiť?"

msgid "Missing Inner Command"
msgstr "Zistili sme, že pri príkaze `{command}` na riadku {line_number} zrejme chýba ďalší príkaz. Pozrieš sa do cvičenia, ktorý príkaz použiť?"

msgid "Missing Square Brackets"
msgstr "Zistili sme, že zoznamu z riadka {line_number} chýbajú hranaté zátvorky `[]`. Skúsiš zoznam obaliť zátvorkami `[]`?"

msgid "Missing Variable"
msgstr "Zistili sme, že príkazu `{command}` na začiatku riadka chýba premenná. Skúsiš premennú napísať pred `{command}?`"

msgid "Misspelled At Command"
msgstr "Zistili sme, že `{invalid_argument}` na riadku {line_number} vyzerá ako preklep. Skús namiesto toho napísať `{command}`."

msgid "No Indentation"
msgstr "Zistili sme, že na riadku {line_number} je príliš málo medzier ({leading_spaces}). Pri každom novom bloku skús zväčšiť odsadenie o {indent_size}."

msgid "Non Decimal Variable"
msgstr "Zistili sme, že na riadku {line_number} je číslo, ktoré Hedy nepodporuje. Skúsiš desiatkové číslo, napríklad 2?"

msgid "Parse"
msgstr "Zistili sme, že na riadku {location[0]} sa používa `{character_found}`, čo nie je dovolené. Skúsiš v kóde nájsť chýbajúci alebo navyše znak?"

msgid "Pressit Missing Else"
msgstr "Zistili sme, že v kóde chýba `{else}` pre ostatné stlačenia klávesov. Skúsiš do kódu doplniť `{else}`?"

msgid "Runtime Index Error"
msgstr "Zistili sme, že zoznam {name} je prázdny alebo mu chýba index. Skontroluješ, že zoznam nie je prázdny, alebo do `[]` napíšeš číslo chýbajúceho indexu?"

msgid "Runtime Value Error"
msgstr "Zistili sme, že `{command}` dostal nepovolenú hodnotu `{value}`. {tip}."

msgid "Runtime Values Error"
msgstr "Zistili sme, že `{command}` dostal nepovolené hodnoty `{value}` a `{value}`. {tip}."

msgid "Save Microbit code "
msgstr "Uložiť kód Microbit"

msgid "Too Big"
msgstr "Zistili sme, že program má {lines_of_code} riadkov, ale spracovať vieme len {max_lines} riadkov. Skúsiš program skrátiť?"

msgid "Too Few Indents"
msgstr "Zistili sme, že riadok {line_number} má príliš málo medzier ({leading_spaces}). Skúsiš pridať jednu medzeru navyše?"

msgid "Too Many Indents"
msgstr "Zistili sme, že riadok {line_number} má príliš veľa medzier ({leading_spaces}). Skúsiš navyše medzeru odstrániť?"

msgid "Unexpected Indentation"
msgstr "Zistili sme, že riadok {line_number} má príliš veľa medzier ({leading_spaces}). Skúsiš pri každom novom bloku pridať o {indent_size} medzier viac?"

msgid "Unquoted Assignment"
msgstr "Zistili sme, že text napravo od `{is}` nie je v úvodzovkách. Na tejto úrovni musí byť text v úvodzovkách. Skús to pri texte {text}"

msgid "Unquoted Equality Check"
msgstr "Zistili sme, že kód overuje, či sa premenná rovná viacerým slovám. Skúsiš slová, ktoré chceš overiť, dať do úvodzoviek?"

msgid "Unquoted Text"
msgstr "Zistili sme, že text pri `{ask}` alebo `{print}` nemá úvodzovky. Skúsiš doplniť úvodzovky k {unquotedtext}?"

msgid "Unsupported Float"
msgstr "Zistili sme, že kód používa desatinné čísla, ktoré zatiaľ nie sú podporované. Skúsiš zmeniť `{value}` na celé číslo?"

msgid "Unsupported String Value"
msgstr "Zistili sme, že text obsahuje hodnoty, ktoré v ňom nemôžu byť: `{invalid_value}`. Skúsiš zapísanú hodnotu odstrániť alebo zmeniť jej typ?"

msgid "Unused Variable"
msgstr "Zistili sme, že premenná {variable_name} je definovaná na riadku {line_number}, ale nepoužíva sa. Skúsiš ju použiť, alebo ju odstrániš?"

msgid "Var Undefined"
msgstr "Zistili sme, že premenná `{name}` sa používa skôr, ako je nastavená. Nastavíš ju pred použitím, alebo `{name}` dáš do úvodzoviek?"

msgid "Wrong Level"
msgstr "Zistili sme, že napísaný kód je správny kód Hedy, ale `{offending_keyword}` sa používa na úrovni {working_level}. {tip}"

msgid "Wrong Number of Arguments"
msgstr "Zistili sme, že funkcia {name} má nesprávny počet argumentov: {used_number}. Skúsiš napísať {defined_number}?"

